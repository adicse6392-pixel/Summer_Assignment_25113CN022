#Write a program to count digits in a number.
num=int( input("enter a number:"))
count=0
if num==0:
    count=1
else:
    num=abs(num)
    while num>0:
        num=num//10
        count=count+1
print("The number of digits in the given number is:",count)

#input:12345
#output: The number of digits in the given number is: 5